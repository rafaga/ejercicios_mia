# Proveedor del LLM: anthropic | openai | opencode (OpenCode Go)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENCODE_API_KEY=
# LLM_MODEL=claude-haiku-4-5   # con opencode, p. ej. deepseek-v4-flash (default) o glm-5.3-flash
# OPENCODE_API_STYLE=openai     # "anthropic" para modelos servidos por /messages (p. ej. qwen3.8-max)
# LLM_MAX_TOKENS=8000
# Abstención: el mejor chunk debe superar este score del reranker (0-1)
MIN_SCORE=0.2
# Solo los chunks que superan este score se envían al LLM (los 15 se muestran igual en pantalla)
MIN_CHUNK_SCORE=0.02
# Verificación de citas: score mínimo oración<->chunk citado; STRICT_GROUNDING=1 elimina las oraciones sin respaldo, 0 las marca con ⚠
SUPPORT_MIN_SCORE=0.01
STRICT_GROUNDING=1
# Preguntas relacionadas sugeridas y tope de tokens de la respuesta
RELATED_N=3
# LLM_MAX_TOKENS=4000   # con modelos de razonamiento (p. ej. deepseek) sube a 6000-8000 si la respuesta sale vacía
# LLM_EXTRA_BODY={"reasoning_effort": "low"}   # JSON opcional que se añade a la petición (según lo que acepte el modelo)
# ARXIV_META=arxiv_meta.sqlite   # autores y año para las referencias APA
# BM25_INDEX=bm25_index.pkl
# BGE_SPARSE_INDEX=bge_sparse_index.pkl
# HugginFace API KEY
HF_TOKEN=
direction: down

start: "Inicio" {shape: oval}
init: "Inicializar pesos W(l) y sesgos b(l)\npara cada capa l = 1 .. L" {shape: rectangle}

epoch_check: "¿Quedan épocas\npor recorrer?" {shape: diamond}
sample_check: "¿Quedan muestras\npor procesar en esta época?" {shape: diamond}

forward: "Fase 1 · Propagación hacia adelante" {
  style.fill: "#eaf2ff"
  step: "Para l = 1 .. L:\na(l) = f( W(l) · a(l-1) + b(l) )" {shape: rectangle}
  note: "a(0) = muestra de entrada\nf = función de activación\nL = capa de salida" {shape: text}
}

backward: "Fase 2 · Retropropagación del error" {
  style.fill: "#fff2e0"
  out_delta: "Capa de salida (l = L):\nδ(L) = f'(a(L)) · (y − a(L))" {shape: rectangle}
  hidden_delta: "Para l = L-1 .. 1:\nδ(l) = f'(a(l)) · Σ_k( W(l+1)[k,i] · δ(l+1)[k] )" {shape: rectangle}
  note2: "Importante: usar siempre los pesos W(l+1)\ntal como estaban ANTES de actualizarlos\nen la Fase 3" {shape: text}
  out_delta -> hidden_delta
}

update: "Fase 3 · Actualización de pesos" {
  style.fill: "#e8f9ee"
  step: "Para l = 1 .. L:\nW(l) += α · δ(l) · a(l-1)ᵀ\nb(l) += α · δ(l)" {shape: rectangle}
  note3: "Se aplica DESPUÉS de calcular\ntodos los δ(l) en la Fase 2" {shape: text}
}

calc_error: "Calcular el error total\nsobre el conjunto de datos" {shape: rectangle}
finish: "Fin — pesos entrenados" {shape: oval}

start -> init -> epoch_check
epoch_check -> sample_check: "sí"
sample_check -> forward: "sí, hay muestra"
forward.step -> backward.out_delta
backward.hidden_delta -> update.step
update.step -> sample_check: "siguiente muestra"
sample_check -> calc_error: "no quedan muestras"
calc_error -> epoch_check: "registrar error de la época"
epoch_check -> finish: "no"
